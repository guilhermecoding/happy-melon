# URL pública do site (metadata / OG). Em `pnpm dev` o auth client usa o origin do browser.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Como o servidor Next alcança a API. Em `pnpm dev`: localhost. O Compose já define http://api:3000.
INTERNAL_API_URL=http://localhost:3000

# Hostnames extras permitidos no next dev (sem protocolo/porta), separados por vírgula
# Ex.: 127.0.0.1,*.localhost
ALLOWED_DEV_ORIGINS=
