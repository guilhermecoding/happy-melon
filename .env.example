# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hm-db
POSTGRES_PORT=5432

# Portas publicadas no host
API_PORT=3000
WEB_PORT=3001

# API → banco (host "postgres" = serviço do Compose)
# Em desenvolvimento local (API no host), use localhost em vez de postgres.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/hm-db

# URL pública do *site* (o que as pessoas abrem). Auth e cookies usam este origin.
# Em produção use https://seudominio.com nas três.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Seed do primeiro admin (opcional; ver README)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
