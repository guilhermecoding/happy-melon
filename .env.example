# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hm-db
POSTGRES_PORT=5432

# Portas publicadas no host
API_PORT=3000
WEB_PORT=3001

# API → banco (host "postgres" = serviço do Compose)
# Em desenvolvimento local (API no host), use localhost em vez de postgres.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/hm-db

# Better Auth (API)
# Gere um secret forte, ex.: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Use https:// em produção (cookies Secure). Em local Docker, deixe http://
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3001

# Web — inlined no build do Next (build-arg). URL que o *browser* chama.
# Se mudar, rebuild: docker compose build --no-cache web
NEXT_PUBLIC_API_URL=http://localhost:3000

# Só para o servidor Next dentro do Docker (compose já define http://api:3000).
# Em pnpm dev no host, deixe vazio / omita.
# INTERNAL_API_URL=http://api:3000

# Seed do primeiro admin (opcional; ver README)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
